{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["id", "name", "entity_type", "summary", "sources"], "additionalProperties": false,
  "properties": {
    "id": {"type": "string"}, "name": {"type": "string"}, "entity_type": {"const": "task"},
    "summary": {"type": "string"}, "input": {"type": "string"}, "output": {"type": "string"},
    "sources": {"type": "array", "items": {"type": "object", "required": ["url", "type", "fields"], "properties": {"url": {"type": "string", "format": "uri"}, "type": {"type": "string"}, "fields": {"type": "array", "items": {"type": "string"}}}}}
  }
}
